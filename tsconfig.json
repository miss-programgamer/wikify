{
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "lib",
		"target": "ESNext",
		"module": "NodeNext",
		"esModuleInterop": true,
		"lib": [
			"esnext",
			"dom",
			"dom.iterable"
		],
