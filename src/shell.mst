<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<title>{{name}}</title>
	<style>{{{mdstyle}}}</style>
	<style>{{{style}}}</style>
</head>
<body>
	<main class="wikify-card">
		<div class="wikify-tocs">
			{{#tocs}}
			
			{{#href}}
			<div><a href="{{{href}}}">{{label}}</a></div>
			{{/href}}
			
			{{^href}}
			<div>{{label}}</div>
			{{/href}}
			<ul>
				{{#links}}
				<li><a href="{{{href}}}">{{{name}}}</a></li>
				{{/links}}
			</ul>
			{{/tocs}}
		</div>
		<div class="markdown-body">{{{body}}}</div>
	</main>
	<footer class="wikify-card">{{name}}</footer>
</body>
</html>